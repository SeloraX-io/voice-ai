# Copy this file to .env.local and fill in your key.
#
# SERVER-ONLY. This key is read by the Node voice gateway (server/) and by the
# Next.js route handler for Upload mode. It is never sent to the browser.
# Do NOT rename it to NEXT_PUBLIC_GEMINI_API_KEY — that would expose it.
GEMINI_API_KEY=

# --- Database (required) ------------------------------------------------

# MongoDB connection string. All persistent state lives here: the agent
# configuration and its secret values, call history and transcripts, SIP and
# Selorax credentials, and the gateway's API keys.
#
# Both processes read it — Next and the voice gateway — which is what lets them
# run on different hosts. SERVER-ONLY, and the single most sensitive value in
# the project.
MONGODB_URI=

# Which database inside that cluster. An Atlas SRV string usually carries no
# database name, so this is separate.
MONGODB_DB=voice-ai

# --- Optional -----------------------------------------------------------

# Port and path the voice gateway listens on.
VOICE_GATEWAY_PORT=4000
VOICE_GATEWAY_PATH=/voice

# Where the browser should connect. Safe to expose: it is a public endpoint,
# not a credential. Defaults to ws://<current-host>:4000/voice when unset.
# NEXT_PUBLIC_VOICE_GATEWAY_URL=ws://localhost:4000/voice

# Demand an API key on every gateway connection. OFF unless set to 1 (or true),
# so a fresh checkout runs with no setup — but anyone who can reach the port can
# then open a billed AI session. Turn it on for anything reachable beyond your
# own machine.
#
# Keys are minted in the console at /settings/keys and presented either as
# `Authorization: Bearer <key>` or as `?key=<key>` on the gateway URL. Only a
# hash is stored, so a key is shown once and never again.
# VOICE_GATEWAY_REQUIRE_KEY=1

# The key the CONSOLE itself presents — the preview player and the softphone
# bridge, both of which are browsers and cannot send headers. Only needed when
# VOICE_GATEWAY_REQUIRE_KEY is on.
#
# Being NEXT_PUBLIC, this IS inlined into the JavaScript bundle and readable by
# anyone who loads the console. Mint it a key of its own so it can be revoked on
# its own.
#
# Note what that means today: the console and /api/api-keys are themselves
# unauthenticated, so anyone who can reach port 3000 can lift this key out of
# the bundle, mint keys of their own, list every key's name and fingerprint, and
# revoke them all — denying service to the phone bridge. Gateway keys defend
# port 4000 against direct exposure; they do not protect the console. Put the
# console behind authentication or behind a private network.
# NEXT_PUBLIC_VOICE_GATEWAY_KEY=
