{
  "name": "voice-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,gateway -c cyan,magenta \"npm:dev:web\" \"npm:dev:gateway\"",
    "dev:web": "next dev",
    "dev:gateway": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "gateway": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\" \"server/**/*.test.ts\""
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jssip": "^3.13.8",
    "lucide-react": "^1.31.0",
    "mongodb": "^7.5.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
